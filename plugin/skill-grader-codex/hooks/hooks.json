{
  "description": "Reads each skill Codex loads that it hasn't shown you yet (run-safety), flags malicious ones, and blocks a flagged skill's scripts from running.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEX_PLUGIN_ROOT}/../shared/run-node.sh\" \"${CODEX_PLUGIN_ROOT}/scripts/scan-session.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEX_PLUGIN_ROOT}/../shared/run-node.sh\" \"${CODEX_PLUGIN_ROOT}/scripts/scan-command.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
