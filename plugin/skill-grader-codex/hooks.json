{
  "description": "Reads each skill Codex loads that it hasn't shown you yet and flags risky ones.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"./shared/run-node.sh\" \"./scripts/scan-session.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"./shared/run-node.sh\" \"./scripts/scan-command.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
